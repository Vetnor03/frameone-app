  "guardrails": {
    "defaultFirmwareUnchanged": true,
    "routeToRuntime": false,
    "noShapeSpecificRenderers": true,
    "neverTruncateDate": true,
    "noPartialRendering": true,
    "doNotAssumeCalendarOrArtFitsFromShape": true,
    "evaluationOrder": [
      "facts",
      "matteIntersection",
      "candidateComposition",
      "F2GlyphMeasurement",
      "priorityBasedDegradation",
      "atomicDrawOrLegacyFallback"
    ]
