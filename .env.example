NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# TEMP_REFRESH_AUDIT: temporary server ingestion switch. Disabled unless exactly true.
TEMP_REFRESH_AUDIT_ENABLED=false

# Server-only credentials for waste provider fallback and the daily sync endpoint.
MINRENOVASJON_APP_KEY=
CRON_SECRET=

# Optional model for server-side surf comment interpretation. Uses OPENAI_MODEL otherwise.
SURF_COMMENT_AI_MODEL=

# Base64-encoded 32-byte key used to encrypt integration credentials/tokens at rest.
# Generate with: openssl rand -base64 32
INTEGRATION_CREDENTIALS_KEY=
# Legacy fallback still supported for existing deployments:
# SPOND_CREDENTIALS_KEY=

# Microsoft Teams OAuth settings.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional. Defaults to /api/integrations/teams/callback on the current app origin.
MICROSOFT_REDIRECT_URI=
# Resend API key used only for app-sent transactional emails (for example, waitlist welcome emails).
RESEND_API_KEY=
# All customer-facing contact, reply-to, and internal notification destinations use
# app/lib/contactEmail.ts during pilot. Change that shared address before launch.
# Transactional emails continue sending from the verified login@re-mind.no domain.

# Radar source probes are observation-only. Keep off unless intentionally shadowing.
RADAR_SOURCE_PROBE_MODE=off
RADAR_SOURCE_PROBE_BATCH_SIZE=20
RADAR_MAX_ACTIVE_SOURCES_PER_WATCH=3
RADAR_SOURCE_MAX_BYTES=524288
RADAR_SOURCE_TIMEOUT_MS=8000

# Licensed IRN Bønnetid API key. Server only; request commercial usage permission first.
BONNETID_API_TOKEN=
