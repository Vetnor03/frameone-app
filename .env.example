NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base64-encoded 32-byte key used to encrypt integration credentials/tokens at rest.
# Generate with: openssl rand -base64 32
INTEGRATION_CREDENTIALS_KEY=
# Legacy fallback still supported for existing deployments:
# SPOND_CREDENTIALS_KEY=

# Microsoft Teams OAuth settings.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional. Defaults to /api/integrations/teams/callback on the current app origin.
MICROSOFT_REDIRECT_URI=
