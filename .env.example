NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base64-encoded 32-byte key used to encrypt integration credentials/tokens at rest.
# Generate with: openssl rand -base64 32
INTEGRATION_CREDENTIALS_KEY=
# Legacy fallback still supported for existing deployments:
# SPOND_CREDENTIALS_KEY=

# Microsoft Teams OAuth settings.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional. Defaults to /api/integrations/teams/callback on the current app origin.
MICROSOFT_REDIRECT_URI=
# Resend API key used only for app-sent transactional emails (for example, waitlist welcome emails).
RESEND_API_KEY=
# Optional reply-to address for waitlist welcome emails.
WAITLIST_REPLY_TO=vetlecn@live.no
# Private server-side recipient for internal waitlist signup notifications.
WAITLIST_NOTIFY_EMAIL=vetlecn@live.no
