# RE:MIND Alfred V1.2 production automatic-light-sleep configuration.
# This is applied when rebuilding the ESP32-S3 Arduino libraries used by
# Arduino-ESP32 3.3.11 / ESP-IDF 5.5.5.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_FREERTOS_HZ=1000
# Keep the log wrapping expected by the 3.3.x Arduino/Insights library set.
CONFIG_DIAG_USE_EXTERNAL_LOG_WRAP=y
